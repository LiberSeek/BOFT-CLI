#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

case "$remote_name" in
  upstream)
    echo "Push blocked: upstream is fetch-only (${remote_url})." >&2
    exit 1
    ;;
  public)
    allowed_branch='ce'
    allowed_prefix='refs/heads/ce/'
    allowed_extra_prefix='refs/heads/upstream/'
    ;;
  origin)
    allowed_branch='ee'
    allowed_prefix='refs/heads/ee/'
    allowed_extra_prefix=''
    ;;
  *)
    exit 0
    ;;
esac

current_branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "$remote_ref" == refs/tags/* ]]; then
    if [[ "$remote_ref" != refs/tags/v* || "$current_branch" != "$allowed_branch" ]]; then
      echo "Push blocked: only an annotated v* release tag from ${allowed_branch} may be pushed to ${remote_name}." >&2
      exit 1
    fi
    if [[ "$(git cat-file -t "$local_oid")" != "tag" ]]; then
      echo "Push blocked: release tag ${remote_ref#refs/tags/} must be annotated." >&2
      exit 1
    fi
    continue
  fi

  if [[ "$local_ref" == refs/heads/$allowed_branch || "$local_ref" == "$allowed_prefix"* ]]; then
    continue
  fi
  if [[ -n "$allowed_extra_prefix" && "$local_ref" == "$allowed_extra_prefix"* ]]; then
    continue
  fi

  echo "Push blocked: ${local_ref} cannot be pushed to ${remote_name}." >&2
  echo "Use ${allowed_branch}, ${allowed_prefix}*, or the configured contribution prefix for ${remote_name}." >&2
  exit 1
done
